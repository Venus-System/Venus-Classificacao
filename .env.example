# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore: nunca commite senhas nem chaves.

# --- Servidor ---
SERVER_PORT=

# --- PostgreSQL (schema venus) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- Segurança ---
# Segredo do JWT do admin: o mesmo do Venus-CRUD, com no mínimo 32 bytes, senão a aplicação não sobe.
ADMIN_JWT_SECRET=
# Projeto do Firebase que emite o token do app
FIREBASE_PROJECT_ID=

# --- Classificação ---
# Id do modelo de score base: quando o modelo pedido não tem regra para um efeito, vale a regra dele
SCORING_BASE_MODEL_ID=
